{
  "extensions": [
    {
      "id": "takeover",
      "name": "Takeover",
      "description": "See and take over the agent's screen: logins, 2FA, CAPTCHAs, payments. Then hand back.",
      "scripts": [
        "assets/takeover.js"
      ],
      "stylesheets": [
        "assets/takeover.css"
      ],
      "sidecar": {
        "type": "loopback",
        "origin": "http://127.0.0.1:17901",
        "health_path": "/health",
        "proxy_auth": "token-v1"
      },
      "permissions": {
        "storage": {
          "owned": true
        },
        "network_external": false,
        "webui_api": {
          "read": [
            "/api/extensions/takeover/sidecar/api/status",
            "/api/extensions/takeover/sidecar/api/pulse"
          ],
          "write": [
            "/api/extensions/takeover/sidecar/api/status",
            "/api/extensions/takeover/sidecar/api/pulse",
            "/api/extensions/takeover/sidecar/api/setup",
            "/api/extensions/takeover/sidecar/api/start",
            "/api/extensions/takeover/sidecar/api/viewer",
            "/api/extensions/takeover/sidecar/api/take-over",
            "/api/extensions/takeover/sidecar/api/hand-back",
            "/api/extensions/takeover/sidecar/api/force-hand-back",
            "/api/extensions/takeover/sidecar/api/dismiss",
            "/api/extensions/takeover/sidecar/api/rfb/open",
            "/api/extensions/takeover/sidecar/api/rfb/send",
            "/api/extensions/takeover/sidecar/api/rfb/recv",
            "/api/extensions/takeover/sidecar/api/rfb/close"
          ]
        }
      }
    }
  ]
}